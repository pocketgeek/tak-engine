# EmbedFiles.cmake -- write binary files into a C++ include as byte arrays.
#
# Script mode: cmake -DOUT=<file.inc> -DFILES="name=path|name=path" -P EmbedFiles.cmake
# Each entry becomes `static const unsigned char <name>[] = {...};` plus
# `static const size_t <name>_size`. Used for the chat-box TrueType faces, which are
# small (~18 KB each after subsetting) and must travel inside takclient so no
# packaging or data-folder lookup is involved.

set(CONTENT "// Generated by cmake/EmbedFiles.cmake -- do not edit.\n#pragma once\n#include <cstddef>\n")
string(REPLACE "|" ";" FILES "${FILES}")
foreach(entry IN LISTS FILES)
  string(FIND "${entry}" "=" eq)
  string(SUBSTRING "${entry}" 0 ${eq} name)
  math(EXPR start "${eq} + 1")
  string(SUBSTRING "${entry}" ${start} -1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
  string(APPEND CONTENT "static const unsigned char ${name}[] = {\n${hex}\n};\nstatic const size_t ${name}_size = ${bytes};\n")
endforeach()
set(OLD "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUT}" "${CONTENT}")
endif()
