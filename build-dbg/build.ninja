build CMakeFiles/cobtool.dir/tools/cobtool.cpp.o: CXX_COMPILER__cobtool_unscanned_Debug /home/pocket_geek/TAK/tools/cobtool.cpp || cmake_object_order_depends_target_cobtool
  CONFIG = Debug
  DEP_FILE = CMakeFiles/cobtool.dir/tools/cobtool.cpp.o.d
  FLAGS = -g -std=gnu++20 -Wall -Wextra
  INCLUDES = -I/home/pocket_geek/TAK/src
  OBJECT_DIR = CMakeFiles/cobtool.dir
  OBJECT_FILE_DIR = CMakeFiles/cobtool.dir/tools
  TARGET_COMPILE_PDB = CMakeFiles/cobtool.dir/
  TARGET_PDB = cobtool.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/cobtool.dir


# =============================================================================
# Link build statements for EXECUTABLE target cobtool


#############################################
# Link the executable cobtool

build cobtool: CXX_EXECUTABLE_LINKER__cobtool_Debug CMakeFiles/cobtool.dir/tools/cobtool.cpp.o | libtak-formats.a /usr/lib64/libz.so /usr/lib64/libjpeg.so || libtak-formats.a
  CONFIG = Debug
  DEP_FILE = CMakeFiles/cobtool.dir/link.d
  FLAGS = -g
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/cobtool.dir/link.d
  LINK_LIBRARIES = libtak-formats.a  /usr/lib64/libz.so  /usr/lib64/libjpeg.so
  OBJECT_DIR = CMakeFiles/cobtool.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/cobtool.dir/
  TARGET_FILE = cobtool
  TARGET_PDB = cobtool.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/cobtool.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/pocket_geek/TAK/build-dbg && /usr/bin/ccmake -S/home/pocket_geek/TAK -B/home/pocket_geek/TAK/build-dbg
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/pocket_geek/TAK/build-dbg && /usr/bin/cmake --regenerate-during-build -S/home/pocket_geek/TAK -B/home/pocket_geek/TAK/build-dbg
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build tak-formats: phony libtak-formats.a

