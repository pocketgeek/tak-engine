[Unit]
Description=Total Annihilation Kingdoms public server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=takserver
StateDirectoryMode=0700
WorkingDirectory=/var/lib/takserver
LoadCredential=tls-key:/etc/takserver/private.pem
ExecStart=/usr/bin/takserver --data /srv/tak-data --accounts /var/lib/takserver/accounts.conf --map-cache-dir /var/lib/takserver/maps --replaydir /var/lib/takserver/replays --tls-cert /etc/takserver/fullchain.pem --tls-key %d/tls-key
ExecStartPre=/usr/bin/mkdir -p /var/lib/takserver/replays
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=8G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
LimitCORE=0
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
