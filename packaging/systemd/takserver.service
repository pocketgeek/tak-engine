[Unit]
Description=Total Annihilation Kingdoms public server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=takserver
StateDirectoryMode=0700
WorkingDirectory=/var/lib/takserver
# Override these through takserver-settings.conf; systemd expands them into argv.
Environment="TAK_SERVER_DATA=/srv/tak-data"
Environment="TAK_SERVER_ACCOUNTS=/var/lib/takserver/accounts.conf"
Environment="TAK_SERVER_MAP_CACHE=/var/lib/takserver/maps"
Environment="TAK_SERVER_REPLAYS=/var/lib/takserver/replays"
Environment="TAK_SERVER_PORT=7677"
Environment="TAK_SERVER_MAX_GAMES=16"
Environment="TAK_SERVER_MAX_RUNNING_GAMES=4"
Environment="TAK_SERVER_MAX_ACCOUNTS=10000"
Environment="TAK_SERVER_MAP_MEMORY_MIB=512"
Environment="TAK_SERVER_MAP_STORAGE_MIB=4096"
Environment="TAK_SERVER_REPLAY_MEMORY_MIB=256"
Environment="TAK_SERVER_REPLAY_STORAGE_MIB=4096"
Environment="TAK_SERVER_EXTRA_ARGS="
LoadCredential=tls-key:/etc/takserver/private.pem
ExecStart=/usr/bin/takserver \
    --data ${TAK_SERVER_DATA} \
    --accounts ${TAK_SERVER_ACCOUNTS} \
    --map-cache-dir ${TAK_SERVER_MAP_CACHE} \
    --replaydir ${TAK_SERVER_REPLAYS} \
    --port ${TAK_SERVER_PORT} \
    --max-games ${TAK_SERVER_MAX_GAMES} \
    --max-running-games ${TAK_SERVER_MAX_RUNNING_GAMES} \
    --max-accounts ${TAK_SERVER_MAX_ACCOUNTS} \
    --map-memory-mib ${TAK_SERVER_MAP_MEMORY_MIB} \
    --map-storage-mib ${TAK_SERVER_MAP_STORAGE_MIB} \
    --replay-memory-mib ${TAK_SERVER_REPLAY_MEMORY_MIB} \
    --replay-storage-mib ${TAK_SERVER_REPLAY_STORAGE_MIB} \
    --tls-cert /etc/takserver/fullchain.pem \
    --tls-key %d/tls-key \
    $TAK_SERVER_EXTRA_ARGS
ExecStartPre=/usr/bin/mkdir -p ${TAK_SERVER_REPLAYS}
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=8G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
LimitCORE=0
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
