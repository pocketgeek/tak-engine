scn 1
name motion-wall
# legion_group_motion's wall case, ported: 48 real ground units (every fifth eligible
# FBI type in name order, araarch .. tarfire, cycled by unit index), unarmed, one player, a flat
# 256x256 map with a wall (124,84) 6x88. Data-gated (needs --data). Every unit is its own group and its own
# tick-1 order, spawned and ordered in the tool's unit order. `wanderers off` clears
# Standby_wander on lifwolf, npchunt and npcshop (12 of the 48 bodies), whose home-pull
# otherwise re-orders them back across the map every 240 ticks; `wanderers on` is the
# original tool's confound (override: legion_scenario --wanderers on|off).
ticks 3000
seed 1
players 1
wanderers off
map flat 256 256
wall 124 84 6 88
type araarch fbi araarch
type araking fbi araking
type arasmith fbi arasmith
type crechie fbi crechie
type cretort fbi cretort
type lifwolf fbi lifwolf
type npcayla fbi npcayla
type npcduma fbi npcduma
type npchunt fbi npchunt
type npcpeas2 fbi npcpeas2
type npcshop fbi npcshop
type tarfire fbi tarfire
group u00 0 araarch 1 cells 56,112
group u01 0 araking 1 cells 56,116
group u02 0 arasmith 1 cells 56,120
group u03 0 crechie 1 cells 56,124
group u04 0 cretort 1 cells 56,128
group u05 0 lifwolf 1 cells 56,132
group u06 0 npcayla 1 cells 56,136
group u07 0 npcduma 1 cells 56,140
